{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "initagent-hub",
      "runtimeExecutable": "./initagent",
      "runtimeArgs": ["serve", "--addr", ":21000", "--data-dir", "/tmp/initagent-dev-data"],
      "port": 21000
