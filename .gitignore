# Build output
/overseer
/initagent
*.exe
/dist/
/ui/dist/
/ui/node_modules/
/site/dist/
/site/node_modules/
/site/.env.local

# Hub installers are owned by /scripts and staged into the site by its Vite
# build (site/vite.config.ts). Never edit or commit the staged copies.
/site/public/install.sh
/site/public/install.ps1
/site/public/install-macos.sh

# Embedded UI is generated by `make ui` — keep only the placeholder.
/cmd/initagent/uidist/*
!/cmd/initagent/uidist/.gitkeep

# Progressive auth backgrounds — sources live in /ui/assets/auth, outputs here.
/ui/public/auth/
/ui/src/assets/auth/bg.gen.ts
/ui/assets/auth/.stamp

# Extra Markdown lives in the parent workspace (always private).
# README.md, LICENSE, and CHANGELOG.md stay. One exception: the partner
# deployment guide, because pware.ai links to it and an external partner has
# no access to the private umbrella (docs/wdrozenie/).
/drafts/
/docs/*
!/docs/wdrozenie/
/backlog.md

# Local glass-desk YAML (copy gdesk.example.yaml). Secrets live here.
/gdesk.yaml
/desk.yaml

# Local dev data
/tmp/
*.db
*.db-shm
*.db-wal

# Local knowledge-graph cache (graphify). Rebuilt on demand, never committed.
/graphify-out/

# Test coverage
coverage*.out
*-cover.out
coverage

# A coverage profile written by an unquoted PowerShell `$profile` on the
# -coverprofile flag. Ignored because it has already happened twice.
/$profile

# Backup of a build artifact. `*.exe` above does not match the tilde.
*.exe~

# OS / editor
.DS_Store
*.log
*.code-workspace
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# agentize workspace (MassTrade)
.agentize/
opencode.json
.omo/

# agentize-generated rules: per-instance, never commit.
.cursor/rules/agentize.auto.generated*

# agentize-generated skills: per-instance, mount re-emits them.
.cursor/skills/agentize.auto.generated*
.opencode/skills/agentize.auto.generated*
