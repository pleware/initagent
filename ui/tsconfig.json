{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "@ia/web": ["../web"],
      "@ia/web/*": ["../web/*"],
      "@base-ui/react/*": ["./node_modules/@base-ui/react/*"],
      "cn": ["./node_modules/cn/dist/index.d.ts"],
      "class-variance-authority": ["./node_modules/class-variance-authority/dist/index.d.ts"],
      "@phosphor-icons/react": ["./node_modules/@phosphor-icons/react/dist/index.d.ts"]
    }
  },
  "include": ["src", "../web/**/*.ts", "../web/**/*.tsx"]
}
